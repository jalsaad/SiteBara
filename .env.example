# Copier ce fichier en .env.local et remplir les valeurs

# Connexion PostgreSQL (VPS OVH)
DATABASE_URL=postgresql://bara:<mot_de_passe>@152.228.139.82:5432/bara

# Clé API Groq (génération de texte IA)
GROQ_API_KEY=<votre_cle_groq>

# Cloudflare Turnstile (anti-spam formulaires contact/préinscription)
# dash.cloudflare.com → Turnstile → Add site → widget "Managed"
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<site_key>
TURNSTILE_SECRET_KEY=<secret_key>
